#!/usr/bin/env bash
# Nothing goes up whose app tree never passed tools/validate.sh (observation 0029, 09/11): pre-commit validates what it
# commits, but a clean cherry-pick, a rebase or a merge makes commits without it. Each pushed commit's app tree must be
# one pre-commit (or this hook) validated; if the one being pushed is the checked-out commit and the tree is clean, it
# is validated here instead of refused.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE
zero=0000000000000000000000000000000000000000
empty_tree=$(git hash-object -t tree /dev/null)   # what a first commit is compared with
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue   # deleting a branch
  key=$(tools/validated.sh key "$local_sha")
  # The commits on the way go up too, and only the last one used to be looked at (audit 10/11). The ones the remote has
  # not seen (not under its side of this branch nor on any remote-tracking ref), merges aside, must not change the app
  # to a tree that never passed. Only git reads, and before the last one's validation: a refusal must not cost a build.
  seen=(--remotes); git cat-file -e "$remote_sha^{commit}" 2>/dev/null && seen+=("$remote_sha")
  never=""
  for c in $(git rev-list --no-merges "$local_sha" --not "${seen[@]}"); do
    k=$(tools/validated.sh key "$c")
    [ "$k" = "$key" ] && continue   # the app tree being pushed: looked at below
    parent=$(git rev-parse -q --verify "$c^" || echo "$empty_tree")
    [ "$k" = "$(tools/validated.sh key "$parent")" ] && continue   # does not touch the app
    tools/validated.sh has "$k" || never+="  $(git log -1 --format='%h %s' "$c")"$'\n'
  done
  if [ -n "$never" ]; then
    echo "Push refused: these commits change the app and their tree never passed tools/validate.sh (a cherry-pick or a"
    echo "rebase skips pre-commit):"
    printf '%s' "$never"
    echo "Validate each one: check it out, run tools/validate.sh, then"
    echo "  tools/validated.sh add \"\$(tools/validated.sh key HEAD)\""
    echo "or squash them into a validated commit."
    exit 1
  fi
  tools/validated.sh has "$key" && continue
  if [ "$(git rev-parse HEAD)" = "$local_sha" ] && [ -z "$(git status --porcelain --untracked-files=no)" ]; then
    echo "pre-push: $(git log -1 --format=%h "$local_sha") was never validated as a whole: running tools/validate.sh"
    # </dev/null: this loop's input is the list of refs, and a tool reading it would swallow the ones still to check
    tools/validate.sh </dev/null || { echo "Push refused: validation failed"; exit 1; }
    tools/validated.sh add "$key"
  else
    echo "Push refused: $(git log -1 --format=%h "$local_sha") was never validated as a whole (a cherry-pick, rebase or"
    echo "merge skips pre-commit). Check it out with a clean tree and push again, or run tools/validate.sh on it."
    exit 1
  fi
done
exit 0
