<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- só para o navegador de "Importar da internet" e para completar artista/ano -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- músicas do Drive: sem internet ao abrir, espera a conexão voltar para baixar -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Ajustes → Atualizar o app: abrir o instalador com o APK baixado do Drive -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- pedal MIDI Bluetooth (BLE MIDI): procurar e conectar em Ajustes → Pedal. No Android 9 a 11 (o Fire),
         procurar BLE exige a localização; do 12 em diante, as permissões próprias do Bluetooth. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation"
        tools:ignore="UnusedAttribute" /> <!-- antes do 12 a permissão nem existe: o atributo é ignorado -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.software.midi" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <!-- banda na rede local: achar os aparelhos no Wi-Fi (anúncio mDNS), só com o app aberto -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- Android 17+: the band finds and is found on the local network only with this permission (31/10) -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- ler o QR do setlist: pedida só ao abrir o leitor -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <!-- player (modo player): tocar com a tela apagada, na interface de áudio USB -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- the USB interface also records (the USB interface): without this, Android greys out "Always" in its USB chooser and asks
         again every time the cable comes back (device test, 02/11). Nothing is recorded: the input only sets the clock -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- pedido padrão do Android para sair da economia de bateria (tocar com a tela apagada), com aviso antes -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Settings → Advanced: Android settings written by the app; granted once from a computer (adb pm grant) -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <application
        android:name=".StagebookApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:theme="@style/Theme.Stagebook">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboard|keyboardHidden|navigation|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- plugging in the mixer (USB interface or another USB Audio 2.0 interface): Android asks to open the app and
                 grants the USB permission, like the Backing app did (user, 01/11). singleTask: the open app comes
                 back instead of a second copy -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/usb_audio_filter" />
        </activity>
        <service
            android:name=".player.PlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
